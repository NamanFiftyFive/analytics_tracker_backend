APP_NAME=Analytics API
ENVIRONMENT=local
DEBUG=true

# Local Postgres (Homebrew, port 5432). For Docker later, compose overrides HOST/PORT.
POSTGRES_USER=hackathon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hackathon_2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433

# dbmate (migrations) reads these when run from the backend/ folder
DATABASE_URL=postgres://hackathon:change-me@localhost:5432/hackathon_2026?sslmode=disable
DBMATE_MIGRATIONS_DIR=migrations
DBMATE_SCHEMA_FILE=schema.sql

# Auth (JWT). Generate a secret with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=generate-one-see-comment-above
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
